# Provider-agnostic model selection: "<provider>:<model-name>"
# Examples: anthropic:claude-sonnet-5 | openai:gpt-4o | google_genai:gemini-1.5-pro
# Install the matching extra in pyproject.toml (e.g. pip install -e ".[anthropic]")
LLM_MODEL=

# Set only the API key for whichever provider LLM_MODEL points to.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
